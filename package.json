{
  "name": "ocpp-kit",
  "version": "0.3.0",
  "description": "Type-safe OCPP 1.6-J and OCPP 2.0.1 toolkit for Node.js: RPC framing, a Central System serving both versions, clients, simulators for load testing mixed fleets and a conformance checker for Central Systems.",
  "keywords": [
    "ocpp",
    "ocpp16",
    "ocpp201",
    "ocpp-j",
    "ev-charging",
    "csms",
    "charge-point",
    "charging-station",
    "websocket",
    "simulator",
    "typescript",
    "conformance"
  ],
  "license": "MIT",
  "author": "Houssam Mehdi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/houssammehdi/ocpp-kit.git"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ocpp-kit": "./dist/cli/main.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "bench": "tsx bench/run.ts",
    "docs": "typedoc",
    "example:csms": "tsx examples/basic-csms.ts",
    "example:charge-point": "tsx examples/basic-charge-point.ts",
    "example:smart-charging": "tsx examples/smart-charging.ts",
    "example:multi-version": "tsx examples/multi-version.ts"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^20.19.43",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typedoc": "0.28.20",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  }
}
